;; Annotations for clj-kondo rules not implemented in clj-kondo-fix.
;; Implemented rules are derived automatically from rules.clj.
;;
;; Statuses:
;;   :skipped         — auto-fix attempted but not safe / incomplete
;;   :not-applicable  — cannot be meaningfully auto-fixed
;;   :not-implemented — could potentially be auto-fixed; not yet done
;;
;; Rules absent from this file and not in rules.clj default to :not-implemented.

{;; ---- skipped ----------------------------------------------------------------
 ;; refer-all: fix strips :refer :all but cannot produce an explicit refer list
 ;; without clj-kondo analysis data (var-usages), which findings alone do not
 ;; provide.
 :refer-all {:status :skipped
             :reason "Strips :refer :all but cannot determine which symbols are
actually used without analysis data; produces broken namespaces for files that
rely on referred symbols"}

