#!/usr/bin/env bash
# Symlink clj-kondo-fix so it takes precedence over the Homebrew-installed version.
# Usage: ./bin/link [dest-dir]
#   dest-dir defaults to $(brew --prefix)/bin if brew is available, otherwise /usr/local/bin
set -euo pipefail

src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src != /* ]] && src="$dir/$src"
done
bin_dir="$(cd -P "$(dirname "$src")" && pwd)"
launcher="$bin_dir/clj-kondo-fix"

if [ -n "${1:-}" ]; then
  dest_dir="$1"
elif command -v brew >/dev/null 2>&1; then
  dest_dir="$(brew --prefix)/bin"
else
  dest_dir="/usr/local/bin"
fi

dest="$dest_dir/clj-kondo-fix"

mkdir -p "$dest_dir"
ln -sf "$launcher" "$dest"
echo "linked: $dest -> $launcher"
echo "run 'clj-kondo-fix --help' to verify"
